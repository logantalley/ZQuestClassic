diff --git a/CMakeLists.txt b/CMakeLists.txt
index a6ba24af3..cfc918acc 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -386,7 +386,13 @@ if(ALLEGRO_SDL)
    set(ALLEGRO_UNIX 0)
    set(ALLEGRO_MACOSX 0)
    set(WANT_X11 off)
-   include(FindSDL2)
+   if(NINTENDO_3DS)
+      # No OpenGL; the parent project adds a software display driver.
+      set(WANT_OPENGL off)
